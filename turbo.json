{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN",
    "DOTENV_CONFIG_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_*",
        "NEXT_STANDALONE",
        "NEXT_DIST_DIR",
        "CLIENT_API_INTERNAL_URL",
        "VITE_*"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "dist/**",
        "build/**",
        "src/generated/prisma/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "NEXT_PUBLIC_*",
        "NEXT_DIST_DIR",
        "CLIENT_API_INTERNAL_URL",
        "VITE_*"
      ],
      "cache": false,
      "persistent": true
    },
    "@oim/nest-backend#dev": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["POSTGRES_*", "CLIENT_*", "ADMIN_*"],
      "cache": false,
      "persistent": true
    },
    "@oim/nest-backend#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "src/generated/prisma/**"],
      "passThroughEnv": ["POSTGRES_*"]
    },
    "@oim/nest-backend#check-types": {
      "dependsOn": ["^build", "^check-types"],
      "outputs": ["src/generated/prisma/**"],
      "passThroughEnv": ["POSTGRES_*"]
    }
  }
}
