# Постоянный файл на сервере: /opt/template-monorepo/.env (права 600).
# init-env.sh создаёт его со случайными секретами только при первом запуске.
# Значения ниже — подсказки, не рабочие production credentials.
POSTGRES_USER=demo
POSTGRES_DB=demo
# Для подстановки в DATABASE_URL используйте hex-пароль: openssl rand -hex 32.
POSTGRES_PASSWORD=replace-with-random-hex
CLIENT_JWT_SECRET=replace-with-independent-random-hex
ADMIN_JWT_SECRET=replace-with-independent-random-hex
MINIO_ROOT_USER=demo-root
MINIO_ROOT_PASSWORD=replace-with-random-hex
# Отдельный пользователь MinIO, запись только в demo-media; photos/ доступен для публичного чтения.
S3_ACCESS_KEY=demo-app
S3_SECRET_KEY=replace-with-random-hex
# Создаёт admin/OWNER при первом деплое; пароль существующего аккаунта не заменяется.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-random-password
# Идемпотентный каталог: 24 позиции с фото, владелец catalog-owner. Пароль существующего аккаунта сохраняется.
CATALOG_OWNER_PASSWORD=replace-with-another-random-password

# Для работы AI-чата добавьте настоящий ключ в серверный .env; не сохраняйте его в репозитории.
# Без ключа остальные API работают, а новая реплика помощника возвращает AI_UNAVAILABLE.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_VISION_MODEL=openai/gpt-4.1

# Необязательный исходящий HTTPS-прокси только для Client API (GOST на хосте).
# Адрес должен быть доступен из контейнера; 127.0.0.1 внутри него — сам контейнер.
# Gateway Docker-сети проверьте через docker network inspect, не выводите из подсети.
CLIENT_USE_ENV_PROXY=0
CLIENT_HTTPS_PROXY=
CLIENT_NO_PROXY=localhost,127.0.0.1,::1,client-api,admin-api,minio,postgres,web-app

# IMAGE_PREFIX, IMAGE_TAG и CADDY_CONFIG_FILE записывает deploy.sh
# в release.env выбранного релиза. Они не являются секретами.
# При пересечении с другими сетями измените подсеть, динамический диапазон и адрес ingress вместе:
# CADDY_SUBNET=172.30.88.0/24
# CADDY_DYNAMIC_RANGE=172.30.88.128/25
# CADDY_IP=172.30.88.2
