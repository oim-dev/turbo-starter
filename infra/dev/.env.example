# ==================================
# БАЗА ДАННЫХ
# ==================================
POSTGRES_PORT=5544
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=default-db

# ==================================
# ФАЙЛОВОЕ ХРАНИЛИЩЕ
# ==================================
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=user
S3_SECRET_KEY=password
S3_BUCKET=default-bucket
S3_REGION=us-east-1
S3_CORS_ALLOW_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ==================================
# ОЧЕРЕДЬ ИЗОБРАЖЕНИЙ
# ==================================
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=image
RABBITMQ_PASSWORD=image-password
RABBITMQ_VHOST=images

# ==================================
# ОБРАБОТКА ИЗОБРАЖЕНИЙ
# ==================================
IMGPROXY_PORT=18080
IMGPROXY_WORKERS=2
IMGPROXY_MAX_SRC_RESOLUTION=40
IMGPROXY_KEY=1111111111111111111111111111111111111111111111111111111111111111
IMGPROXY_SALT=2222222222222222222222222222222222222222222222222222222222222222
