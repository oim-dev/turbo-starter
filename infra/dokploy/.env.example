# ==================================
# ПУБЛИЧНЫЙ АДРЕС
# ==================================
PUBLIC_URL=http://stand.example.org

# ==================================
# БАЗА ДАННЫХ
# ==================================
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=default-db

# ==================================
# АВТОРИЗАЦИЯ
# ==================================
CLIENT_JWT_SECRET=client-secret
ADMIN_JWT_SECRET=admin-secret
BOOTSTRAP_ADMIN_PASSWORD=admin

# ==================================
# ХРАНИЛИЩЕ S3
# ==================================
S3_REGION=us-east-1
S3_BUCKET=default-bucket
S3_ACCESS_KEY=user
S3_SECRET_KEY=password

# ==================================
# ОБРАБОТКА ИЗОБРАЖЕНИЙ
# ==================================
RABBITMQ_USER=image
RABBITMQ_PASSWORD=image-password
IMGPROXY_KEY=1111111111111111111111111111111111111111111111111111111111111111
IMGPROXY_SALT=2222222222222222222222222222222222222222222222222222222222222222
IMAGE_MAX_UPLOAD_BYTES=20971520
IMAGE_MAX_SOURCE_PIXELS=40000000
IMAGE_WORKER_CONCURRENCY=2
