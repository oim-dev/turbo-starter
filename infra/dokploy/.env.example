# ==================================
# ПУБЛИЧНЫЙ АДРЕС
# ==================================
PUBLIC_URL=http://stand.example.org

# ==================================
# БАЗА ДАННЫХ
# ==================================
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-random-postgres-password
POSTGRES_DB=app

# ==================================
# АВТОРИЗАЦИЯ
# ==================================
CLIENT_JWT_SECRET=replace-with-random-client-secret
ADMIN_JWT_SECRET=replace-with-another-random-admin-secret
BOOTSTRAP_ADMIN_PASSWORD=replace-with-random-admin-password

# ==================================
# ХРАНИЛИЩЕ S3
# ==================================
S3_REGION=us-east-1
S3_BUCKET=storage
S3_ACCESS_KEY=stand-storage
S3_SECRET_KEY=replace-with-random-storage-secret

# ==================================
# ОБРАБОТКА ИЗОБРАЖЕНИЙ
# ==================================
RABBITMQ_USER=images
RABBITMQ_PASSWORD=replace-with-random-url-safe-password
IMGPROXY_KEY=1111111111111111111111111111111111111111111111111111111111111111
IMGPROXY_SALT=2222222222222222222222222222222222222222222222222222222222222222
IMAGE_MAX_UPLOAD_BYTES=20971520
IMAGE_MAX_SOURCE_PIXELS=40000000
IMAGE_WORKER_CONCURRENCY=2
