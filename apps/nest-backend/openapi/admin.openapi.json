          "415": {
            "description": "Неподдерживаемое кодирование содержимого или кодировка символов.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "429": {
