        "operationId": "adminBrowserRefresh",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "description": "Реальный Origin запроса, устанавливаемый браузером; должен точно совпадать с разрешённым источником этого API.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Protection",
            "in": "header",
