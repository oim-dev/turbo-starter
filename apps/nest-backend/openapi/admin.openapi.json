              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "Ресурс не найден или недоступен текущему пользователю.",
            "content": {
              "application/json": {
                "schema": {
