            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервера.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "refresh-cookie": []
          }
        ],
        "summary": "Завершить браузерную сессию администратора",
        "tags": [
          "Auth"
        ]
      }
    },
