    "/auth/login": {
      "post": {
        "description": "Возвращает Bearer JWT в accessToken на 7 дней (604800 секунд). Cookie авторизации не устанавливается. По истечении срока требуется новый вход.",
        "operationId": "clientBrowserLogin",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "description": "Корректный HTTP(S) Origin без пути, query или fragment. Принимается любой источник; allowlist не используется.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Protection",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
