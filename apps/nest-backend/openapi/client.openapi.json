  "info": {
    "title": "Starter — клиентское API",
    "description": "Публичное клиентское API. Регистрация создаёт учётную запись, но не сессию.\n\nВход, обновление токенов и выход через браузер требуют заголовков Origin и X-CSRF-Protection: 1. Origin должен входить в allowlist соответствующего API (CLIENT_ALLOWED_ORIGINS или ADMIN_ALLOWED_ORIGINS); тот же список используется для CORS с учётными данными. Для Swagger включите собственный origin API в allowlist.\n\nКаждый токен обновления используется только один раз; подтверждённое повторное использование отзывает сессию. Выполняйте обновление токенов последовательно во всех вкладках и на всех устройствах, использующих одну сессию.\n\nПри потере ответа на запрос обновления токенов может потребоваться повторный вход. Срок действия сессии фиксирован.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "refresh-cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-client_refresh"
      }
    },
    "schemas": {
      "RegisterClientUserDto": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9_.-]{3,64}$",
            "description": "Логин без учёта регистра; сохраняется в нижнем регистре.",
            "example": "client.user"
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 8,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Отображаемое имя: пробелы по краям удаляются до проверки длины, пустое имя запрещено. По умолчанию используется нормализованный логин.",
            "example": "Client User"
          }
        },
        "required": [
          "login",
          "password"
        ]
      },
      "ClientUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "login": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "login",
          "name",
          "isActive",
          "createdAt",
          "updatedAt"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "example": "user123",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9_.-]{3,64}$"
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "login",
          "password"
        ]
      },
      "AccessTokenDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "number",
            "description": "Целое число секунд между iat и exp JWT, не больше настроенного access TTL. Из-за округления секундной границы может превышать фактический остаток жизни сессии; доступ дополнительно ограничен точным sessionExpiresAt.",
            "example": 900
          },
          "sessionExpiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Точный фиксированный срок окончания сессии с миллисекундной точностью; ротация токенов не продлевает его. После этого момента доступ и refresh запрещены, даже если exp JWT ещё не наступил."
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "sessionExpiresAt"
        ]
      },
      "UpdateClientUserProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Отображаемое имя: пробелы по краям удаляются до проверки длины, пустое имя и null запрещены. Если поле отсутствует, имя не меняется.",
            "example": "Client User"
          }
        }
      },
      "ChangeClientUserLoginDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 8,
            "maxLength": 128
          },
          "login": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9_.-]{3,64}$",
            "description": "Уникальный логин без учёта регистра; сохраняется в нижнем регистре."
          }
        },
        "required": [
          "currentPassword",
          "login"
        ]
      },
      "ChangeClientUserPasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 8,
            "maxLength": 128
          },
          "newPassword": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ]
      }
    }
  }
}
