{
  "name": "@oim/nest-backend",
  "description": "Каркас клиентского и административного NestJS API с аккаунтами и сессиями.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "prisma generate && nest build client-api && nest build admin-api",
    "build:client": "prisma generate && nest build client-api",
    "build:admin": "prisma generate && nest build admin-api",
    "dev": "prisma generate && concurrently --kill-others --names client,admin \"nest start client-api --watch\" \"nest start admin-api --watch\"",
    "dev:client": "prisma generate && nest start client-api --watch",
    "dev:admin": "prisma generate && nest start admin-api --watch",
    "start": "concurrently --kill-others --names client,admin \"pnpm start:client\" \"pnpm start:admin\"",
    "start:client": "node dist/client-api/main.js",
    "start:admin": "node dist/admin-api/main.js",
    "start:prod": "pnpm start:client",
    "start:debug": "prisma generate && nest start client-api --debug --watch",
    "format": "prettier --write src prisma.config.ts",
    "lint": "eslint src prisma.config.ts",
    "lint:fix": "pnpm lint --fix",
    "check-types": "prisma generate && tsc --noEmit",
    "typecheck": "pnpm check-types",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "openapi:generate": "prisma generate && ts-node src/export-openapi.ts",
    "db:up": "docker compose -f ../../infra/dev/docker-compose.yml up -d --wait postgres",
    "db:stop": "docker compose -f ../../infra/dev/docker-compose.yml stop postgres"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "openid-client": "6.8.8",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "prisma": "7.9.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
