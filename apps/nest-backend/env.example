# PostgreSQL запускается через ../../infra/dev/docker-compose.yml.
# При изменении POSTGRES_* в infra/dev/.env синхронизируйте DATABASE_URL.
DATABASE_URL=postgresql://starter:starter_dev_password@localhost:5544/starter
NODE_ENV=development

CLIENT_API_HOST=0.0.0.0
CLIENT_API_PORT=3001
ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=3002

# Точные HTTP(S) origins через запятую, без пути, завершающего / и wildcard.
# Собственные origins API нужны для браузерной авторизации через Swagger.
# В production нет allowlist по умолчанию: задайте доверенные origins явно.
CLIENT_ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005,http://localhost:3001,http://127.0.0.1:3001
ADMIN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3002,http://127.0.0.1:3002

# Только для разработки. В production задайте независимые случайные секреты.
CLIENT_JWT_SECRET=development-client-secret-not-for-production-000000000000
ADMIN_JWT_SECRET=development-admin-secret-not-for-production-000000000000
CLIENT_ACCESS_TTL_SECONDS=900
ADMIN_ACCESS_TTL_SECONDS=900
CLIENT_SESSION_TTL_SECONDS=2592000
ADMIN_SESSION_TTL_SECONDS=28800

CLIENT_COOKIE_SAME_SITE=lax
ADMIN_COOKIE_SAME_SITE=lax
# В production Secure обязателен; SameSite=None требует Secure и при разработке.
CLIENT_COOKIE_SECURE=false
ADMIN_COOKIE_SECURE=false

# В production Swagger отключён по умолчанию. Административное API и его
# документацию размещайте за закрытым входным прокси.
# CLIENT_SWAGGER_ENABLED=false
# ADMIN_SWAGGER_ENABLED=false
# Доверяйте только IP-адресам и CIDR ваших обратных прокси.
# CLIENT_TRUSTED_PROXIES=127.0.0.1/32
# ADMIN_TRUSTED_PROXIES=127.0.0.1/32

# Пароль bootstrap-администратора для prisma:seed, обязателен в production.
# BOOTSTRAP_ADMIN_PASSWORD=
