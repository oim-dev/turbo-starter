{
  "name": "@biocad/admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "vite preview",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "pnpm test:auth && vitest run src/domains/publications src/domains/publication-categories",
    "test:auth": "tsx --tsconfig tsconfig.test.json --test src/domains/auth/lib/*.test.ts src/domains/auth/mappers/*.test.ts src/domains/auth/services/*.test.ts src/domains/auth/state/*.test.ts",
    "typecheck": "tsc -b && tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "@biocad/admin-rest-api-sdk": "workspace:*",
    "@biocad/config": "workspace:*",
    "@biocad/rich-text": "workspace:*",
    "@biocad/value-predicates": "workspace:*",
    "@mantine/core": "9.4.2",
    "@mantine/hooks": "9.4.2",
    "@mantine/tiptap": "9.4.2",
    "@tabler/icons-react": "^3.45.0",
    "@tanstack/react-query": "5.87.1",
    "@tiptap/core": "3.30.1",
    "@tiptap/extension-link": "3.30.1",
    "@tiptap/pm": "3.30.1",
    "@tiptap/react": "3.30.1",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "msw": "2.15.0",
    "postcss": "^8.5.20",
    "postcss-custom-media": "^12.0.1",
    "postcss-nesting": "^14.0.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "4.1.10"
  }
