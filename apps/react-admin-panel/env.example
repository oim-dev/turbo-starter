# Общие настройки Vite dev и preview (запускаются по очереди).
# 0.0.0.0 = все интерфейсы; в браузере используйте localhost или 127.0.0.1.
VITE_HOST=localhost
VITE_PORT=5173
# HTTP на loopback соответствует dev allowlist Admin API.
VITE_HTTPS=false

# Proxy targets
VITE_BACKEND_URL=http://127.0.0.1:3002
