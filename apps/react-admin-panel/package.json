{
  "name": "@repo/react-admin-panel",
  "description": "Базовая административная React SPA с авторизацией и профилем администратора.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "create": "pnpm dlx @gromlab/template-file-generator@0.3.1 --skip-update",
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "check-types": "tsc -b --pretty false",
    "typecheck": "pnpm run check-types"
  },
  "dependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@demo/admin-rest-api-sdk": "workspace:*",
    "@mantine/core": "^8.3.10",
    "@mantine/form": "^8.3.10",
    "@mantine/hooks": "^8.3.10",
    "@tabler/icons-react": "^3.36.0",
    "clsx": "^2.1.1",
    "dayjs": "1.11.23",
    "postcss-custom-media": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "swr": "^2.5.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~5.9.3",
