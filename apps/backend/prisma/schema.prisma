generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum SessionTransport {
  BROWSER
  MOBILE
}

enum FileStatus {
  uploading
  ready
  expired
}

model StoredFile {
  id                String     @id @default(uuid()) @db.Uuid
  publicId          String     @unique @db.VarChar(8)
  filename          String     @db.VarChar(255)
  publicFilename    String     @db.VarChar(255)
  title             String     @db.VarChar(255)
  folder            String?    @db.VarChar(255)
  tags              String[]
  status            FileStatus @default(uploading)
  contentType       String     @db.VarChar(100)
  extension         String     @db.VarChar(255)
  byteSize          BigInt
  currentVersionId  String?    @unique @db.Uuid
  currentVersion    FileVersion? @relation("CurrentFileVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  ownerId           String     @db.Uuid
  ownerName         String     @db.VarChar(120)
  ownerLogin        String     @db.VarChar(64)
  uploadExpiresAt   DateTime
  completedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  versions          FileVersion[]
  uploads           FileUpload[]

  @@index([createdAt, id])
  @@index([status, uploadExpiresAt])
  @@index([folder])
  @@index([tags], type: Gin)
}

model FileBlob {
  id              String   @id @default(uuid()) @db.Uuid
  sha256          String   @unique @db.Char(64)
  byteSize        BigInt
  extension       String   @db.VarChar(255)
  objectKey       String   @unique
  objectEtag      String
  objectVersionId String?
  createdAt       DateTime @default(now())
  versions        FileVersion[]
}

model FileVersion {
  id          String     @id @default(uuid()) @db.Uuid
  fileId      String     @db.Uuid
  file        StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  number      Int
  filename    String     @db.VarChar(255)
  contentType String     @db.VarChar(100)
  extension   String     @db.VarChar(255)
  blobId      String     @db.Uuid
  blob        FileBlob   @relation(fields: [blobId], references: [id], onDelete: Restrict)
  ownerId     String     @db.Uuid
  ownerName   String     @db.VarChar(120)
  ownerLogin  String     @db.VarChar(64)
  createdAt   DateTime   @default(now())
  uploads     FileUpload[]
  currentFor  StoredFile? @relation("CurrentFileVersion")

  @@unique([fileId, number])
  @@index([blobId])
}

model FileUpload {
  id              String       @id @default(uuid()) @db.Uuid
  fileId          String       @db.Uuid
  file            StoredFile   @relation(fields: [fileId], references: [id], onDelete: Restrict)
  isNewFile       Boolean
  filename        String       @db.VarChar(255)
  contentType     String       @db.VarChar(100)
  extension       String       @db.VarChar(255)
  byteSize        BigInt
  claimedSha256   String       @db.Char(64)
  ownerId         String       @db.Uuid
  ownerName       String       @db.VarChar(120)
  ownerLogin      String       @db.VarChar(64)
  stagingKey      String       @unique
  multipartUploadId String?
  multipartPartSize BigInt?
  expiresAt       DateTime
  resultVersionId String?      @db.Uuid
  reused          Boolean      @default(false)
  resultVersion   FileVersion? @relation(fields: [resultVersionId], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now())

  @@index([expiresAt])
  @@index([fileId])
}

enum ImageStatus {
  uploading
  queued
  processing
  ready
  failed
}

enum ImageRealm {
  admin
  client
}

enum ImagePreset {
  original
  square
  landscape
}

enum ImageJobStatus {
  queued
  processing
  ready
  failed
}

model Image {
  id                 String         @id @default(uuid()) @db.Uuid
  publicId           String         @unique @db.VarChar(8)
  // Заявленный хеш не является доказательством; originalSha256 вычисляет сервер.
  claimedSha256      String?        @db.Char(64)
  originalSha256     String?        @db.Char(64)
  // Сохраняем попытки и legacy-объекты, скрывая дубли из галереи.
  canonicalId        String?        @db.Uuid
  canonical          Image?         @relation("ImageAliases", fields: [canonicalId], references: [id], onDelete: Restrict)
  aliases            Image[]        @relation("ImageAliases")
  hashClaim          ImageHashClaim?
  filename           String         @db.VarChar(255)
  title              String         @db.VarChar(255)
  folder             String?        @db.VarChar(255)
  tags               String[]
  presets            ImagePreset[]
  status             ImageStatus    @default(uploading)
  // Снимок автора: два независимых контура аккаунтов, без полиморфного FK.
  ownerId            String         @db.Uuid
  ownerRealm         ImageRealm
  ownerName          String         @db.VarChar(120)
  ownerLogin         String         @db.VarChar(64)
  contentType        String         @db.VarChar(100)
  byteSize           Int
  width              Int?
  height             Int?
  stagingKey         String         @unique
  uploadExpiresAt    DateTime
  originalKey        String?        @unique
  originalEtag       String?
  originalVersionId  String?
  completedAt        DateTime?
  errorCode          String?        @db.VarChar(100)
  errorMessage       String?        @db.VarChar(512)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  variants           ImageVariant[]
  job                ImageJob?

  @@index([ownerRealm, ownerId, createdAt, id])
  @@index([status, createdAt, id])
  @@index([folder])
  @@index([tags], type: Gin)
  @@index([canonicalId])
}

model ImageHashClaim {
  scope     String   @db.VarChar(43)
  sha256    String   @db.Char(64)
  imageId   String   @unique @db.Uuid
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([scope, sha256])
}

model ImageVariant {
  id         String      @id @default(uuid()) @db.Uuid
  imageId    String      @db.Uuid
  image      Image       @relation(fields: [imageId], references: [id], onDelete: Cascade)
  preset     ImagePreset
  width      Int
  height     Int
  format     String      @db.VarChar(20)
  mimeType   String      @db.VarChar(100)
  byteSize   Int
  objectKey  String      @unique
  etag       String
  versionId  String?
  createdAt  DateTime    @default(now())

  @@unique([imageId, preset, width, format])
}

model ImageJob {
  id              String         @id @default(uuid()) @db.Uuid
  imageId         String         @unique @db.Uuid
  image           Image          @relation(fields: [imageId], references: [id], onDelete: Cascade)
  status          ImageJobStatus @default(queued)
  attempts        Int            @default(0)
  dispatchVersion Int            @default(1)
  availableAt     DateTime       @default(now())
  deadlineAt      DateTime
  leaseToken      String?        @db.Uuid
  leaseUntil      DateTime?
  errorCode       String?        @db.VarChar(100)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  outbox          ImageOutbox[]

  @@index([status, availableAt])
  @@index([status, leaseUntil])
}

model ImageOutbox {
  id              String    @id @default(uuid()) @db.Uuid
  jobId           String    @db.Uuid
  job             ImageJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  dispatchVersion Int
  destination     String    @default("work") @db.VarChar(20)
  attempts        Int       @default(0)
  availableAt     DateTime  @default(now())
  leaseToken      String?   @db.Uuid
  leaseUntil      DateTime?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([jobId, dispatchVersion, destination])
  @@index([publishedAt, availableAt, leaseUntil])
}

model ClientUser {
  id           String          @id @default(uuid()) @db.Uuid
  login        String          @unique @db.VarChar(64)
  passwordHash String
  name         String          @db.VarChar(120)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     ClientSession[]
}

model AdminUser {
  id             String          @id @default(uuid()) @db.Uuid
  login          String          @unique @db.VarChar(64)
  passwordHash   String?
  isActive       Boolean         @default(true)
  role           String          @default("USER") @db.VarChar(64)
  accessRole     AdminAccessRole @relation(fields: [role], references: [key], onDelete: Restrict)
  name           String          @default("") @db.VarChar(120)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       AdminSession[]
  identities     AdminIdentity[]
  authVersion    Int             @default(0)
  authValidAfter DateTime        @default(now())

  @@index([role, isActive])
}

model AdminAccessRole {
  key         String      @id @db.VarChar(64)
  name        String      @db.VarChar(120)
  permissions String[]
  isBuiltin   Boolean     @default(false)
  version     Int         @default(1)
  users       AdminUser[]
}

model AdminKeycloakSettings {
  id                Int      @id @default(1)
  enabled           Boolean  @default(false)
  issuer            String   @default("https://route66.biocad.ru/realms/biocad") @db.VarChar(512)
  clientId          String   @default("") @db.VarChar(255)
  clientSecret      String?
  callbackUrl       String   @default("http://localhost:3001/api/auth/callback") @db.VarChar(2048)
  frontendCallbackUrl String @default("http://localhost:3001/auth/keycloak/callback") @db.VarChar(2048)
  version           Int      @default(0)
  updatedAt         DateTime @updatedAt
}

model AdminSecurityAudit {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  action    String   @db.VarChar(100)
  target    String   @db.VarChar(100)
  createdAt DateTime @default(now())
}

model ClientSession {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      ClientUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transport SessionTransport
  createdAt DateTime         @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model AdminSession {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  user       AdminUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transport  SessionTransport
  createdAt  DateTime         @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  identityId String?          @db.Uuid
  identity   AdminIdentity?   @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@index([identityId])
}

// Привязки OWNER или первого проверенного OIDC-входа с созданием USER.
model AdminIdentity {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @db.Uuid
  user        AdminUser             @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer      String                @db.VarChar(512)
  subject     String                @db.VarChar(255)
  createdAt   DateTime              @default(now())
  revokedAt   DateTime?
  sessions    AdminSession[]
  completions AdminOidcCompletion[]

  @@unique([issuer, subject])
  @@index([userId])
}

// PKCE/nonce живут только до очистки короткоживущего обмена; upstream tokens не хранятся.
model AdminOidcTransaction {
  stateHash    String               @id @db.Char(64)
  browserHash  String               @db.Char(64)
  codeVerifier String
  nonce        String
  issuer       String               @db.VarChar(512)
  clientId     String               @db.VarChar(255)
  configVersion Int                @default(0)
  callbackUrl  String               @db.VarChar(2048)
  returnTo     String               @db.VarChar(2048)
  createdAt    DateTime             @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?
  completion   AdminOidcCompletion?

  @@index([browserHash])
  @@index([expiresAt])
}

model AdminOidcCompletion {
  tokenHash     String               @id @db.Char(64)
  transactionId String               @unique @db.Char(64)
  transaction   AdminOidcTransaction @relation(fields: [transactionId], references: [stateHash], onDelete: Cascade)
  identityId    String               @db.Uuid
  identity      AdminIdentity        @relation(fields: [identityId], references: [id], onDelete: Cascade)
  authVersion   Int
  createdAt     DateTime             @default(now())
  expiresAt     DateTime
  consumedAt    DateTime?

  @@index([identityId])
  @@index([expiresAt])
}
