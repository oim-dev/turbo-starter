{
  "name": "@oim/next-web-app",
  "description": "Стартовое веб-приложение на Next.js, Mantine и Unit Architecture.",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "create": "pnpm dlx @gromlab/template-file-generator@0.3.1 --skip-update",
    "dev": "next dev --port 3005",
    "build": "next build",
    "start": "next start --port 3005",
    "lint": "eslint .",
    "check-types": "next typegen && tsc --noEmit",
    "typecheck": "pnpm run check-types"
  },
  "dependencies": {
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@tabler/icons-react": "^3.46.0",
    "@oim/client-rest-api-sdk": "workspace:*",
    "clsx": "2.1.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "4.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "10.5.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.26",
    "postcss-custom-media": "12.0.1",
    "postcss-nesting": "14.0.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
