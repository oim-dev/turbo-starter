# Публичный адрес Client API для прямых запросов браузера. Фиксируется при next build.
NEXT_PUBLIC_CLIENT_API_URL=http://localhost:3001
# Refresh-cookie, CORS и SameSite настраиваются на backend. В Next.js credentials не хранятся.
# Необязательный внутренний адрес для SSR только публичных данных. Без него используется публичный адрес выше.
# CLIENT_API_INTERNAL_URL=http://localhost:3001

# Стартовая страница API не вызывает; эти настройки нужны только сохраняемым API-клиентам.
# При относительном browser URL серверным публичным операциям нужен абсолютный CLIENT_API_INTERNAL_URL.

# Только для standalone-сборки контейнера; не требуется для локальных build/start.
# NEXT_STANDALONE=1
