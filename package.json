{
  "name": "@oim/oim",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "pnpm run env:check && turbo run lint",
    "env:check": "node scripts/check-env.mjs",
    "worktree:create": "node scripts/worktrees/cli.mjs create",
    "worktree:up": "node scripts/worktrees/cli.mjs up",
    "worktree:status": "node scripts/worktrees/cli.mjs status",
    "worktree:down": "node scripts/worktrees/cli.mjs down",
    "worktree:remove": "node scripts/worktrees/cli.mjs remove",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "infra:dev:up": "docker compose -f infra/dev/docker-compose.yml up -d --wait",
    "infra:dev:down": "docker compose -f infra/dev/docker-compose.yml down",
    "infra:dev:logs": "docker compose -f infra/dev/docker-compose.yml logs --follow",
    "backend:dev": "pnpm --filter @oim/backend dev",
    "backend:dev:client": "pnpm --filter @oim/backend dev:client",
    "backend:dev:admin": "pnpm --filter @oim/backend dev:admin",
    "backend:dev:worker": "pnpm --filter @oim/backend dev:worker",
    "backend:build": "pnpm --filter @oim/backend build",
    "backend:lint": "pnpm --filter @oim/backend lint",
    "backend:check-types": "pnpm --filter @oim/backend check-types",
    "backend:prisma:generate": "pnpm --filter @oim/backend prisma:generate",
    "backend:prisma:deploy": "pnpm --filter @oim/backend prisma:deploy",
    "backend:openapi:generate": "pnpm --filter @oim/backend openapi:generate",
    "web:dev": "turbo run dev --filter=@oim/web --ui=stream",
    "web:build": "turbo run build --filter=@oim/web",
    "web:lint": "turbo run lint --filter=@oim/web",
    "web:check-types": "turbo run check-types --filter=@oim/web",
    "web:start": "pnpm --filter @oim/web start",
    "admin:dev": "turbo run dev --filter=@oim/admin --ui=stream",
    "admin:build": "turbo run build --filter=@oim/admin",
    "admin:lint": "turbo run lint --filter=@oim/admin",
    "admin:check-types": "turbo run check-types --filter=@oim/admin",
    "admin:preview": "pnpm --filter @oim/admin preview",
    "rest-api-sdk:generate": "pnpm backend:openapi:generate && pnpm --filter @oim/client-rest-api-sdk --filter @oim/admin-rest-api-sdk -r run generate",
    "rest-api-sdk:build": "pnpm --filter @oim/client-rest-api-sdk --filter @oim/admin-rest-api-sdk -r run build",
    "rest-api-sdk:check-types": "pnpm --filter @oim/client-rest-api-sdk --filter @oim/admin-rest-api-sdk -r run check-types",
    "agents:build": "pnpm --silent --filter @oim/dev-agents run build",
    "agents:check": "pnpm --silent --filter @oim/dev-agents run check"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.6",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
